# ============================================================
# Project LOOP — Environment Variables Template
# ============================================================

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-secret-key-here"
AUTH_SECRET="your-32-character-secret-key-here"

# Multi-AI Provider Configuration
# Options: "auto" (default fallback) | "anthropic" | "openai" | "google"
AI_PROVIDER="auto"
AI_MODEL="claude-sonnet-4-6"

# 1. Anthropic Claude (claude-sonnet-4-6, claude-3-5-sonnet, claude-haiku-4-5)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# 2. OpenAI (gpt-4o, gpt-4o-mini, o3-mini)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 3. Google Gemini (gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Embeddings (for Ask LOOP Semantic Search)
VOYAGE_API_KEY=""
EMBEDDING_PROVIDER="voyage"

# Google OAuth Provider (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Email Configuration (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Project LOOP <noreply@yourdomain.com>"

# Developer Panel (Access at /dev)
DEV_PANEL_PASSWORD="your-dev-password-here"
